<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Digital books assets manager</title>
</head>
<body>

  <!-- Uključujemo naš sređeni navbar -->
  <%- include('./partials/navbar') %>

  <h1>Digital books assets manager</h1>
  <p>Workflow management application</p>

  <% if (currentUser) { %>
    <h2>Wellcome!<%= currentUser.username %>!</h2>
    <p>You are logged in as: <strong><%= currentUser.role %></strong></p>
    
    <% if (currentUser.role === 'editor') { %>
      <p><a href="/requests">Idi na Pregled Zahteva</a></p>
    <% } else if (currentUser.role === 'processor') { %>
      <p><a href="/requests">Go to Tasks</a></p>
    <% } %>
  <% } else { %>
    <p>Register to continue.</p>
  <% } %>

</body>
</html>