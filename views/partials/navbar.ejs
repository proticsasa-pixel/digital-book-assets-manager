<nav class="navbar <%= currentUser && currentUser.role === 'admin' ? 'admin-navbar' : '' %>">
  <a href="/" class="nav-brand">ZUNS Digital Assets</a>
  
  <div class="nav-links">
    <% if (currentUser) { %>
      <a href="/">Home</a>
      
      <% if (currentUser.role === 'admin') { %>
        <a href="/auth/new-user">Create User</a>
        <a href="/requests">Requests</a>
        <a href="/publications">Publications</a>
        <span class="user-badge">(admin: <%= currentUser.username %>)</span>
      <% } %>

      <% if (currentUser.role === 'editor') { %>
        <a href="/requests">Requests</a>
        <a href="/publications">Publications</a>
        <span class="user-badge">(editor: <%= currentUser.username %>)</span>
      <% } %>

      <% if (currentUser.role === 'processor') { %>
        <a href="/requests">Tasks / Requests</a>
        <a href="/publications">Publications</a>
        <span class="user-badge">(processor: <%= currentUser.username %>)</span>
      <% } %>

      <a href="/auth/sign-out">Sign Out</a>
    <% } else { %>
      <a href="/auth/sign-in">Sign In</a>
    <% } %>
  </div>
</nav>